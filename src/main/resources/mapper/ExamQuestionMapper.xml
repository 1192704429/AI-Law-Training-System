<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.law.train.module.exam_question.mapper.ExamQuestionMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND examQuestion.id = #{entity.id}
            </if>
            <if test="entity.questionTitle != null and entity.questionTitle != ''">
                AND examQuestion.question_title LIKE CONCAT('%', #{entity.questionTitle}, '%')
            </if>
            <!-- 题目类型：当前系统仅支持 1单选 2多选 5主观题；3填空 4判断保留 -->
            <choose>
                <when test="entity.questionTypeList != null and entity.questionTypeList.size() > 0">
                    AND examQuestion.question_type IN
                    <foreach collection="entity.questionTypeList" item="type" open="(" separator="," close=")">
                        #{type}
                    </foreach>
                </when>
                <when test="entity.questionType != null">
                    AND examQuestion.question_type = #{entity.questionType}
                </when>
            </choose>
            <if test="entity.difficultyLevel != null">
                AND examQuestion.difficulty_level = #{entity.difficultyLevel}
            </if>
            <if test="entity.status != null">
                AND examQuestion.status = #{entity.status}
            </if>
            <if test="entity.courseId != null">
                AND examQuestion.course_id = #{entity.courseId}
            </if>
            <if test="entity.courseName != null and entity.courseName != ''">
                AND examCourse.course_name LIKE CONCAT('%', #{entity.courseName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.law.train.module.exam_question.entity.ExamQuestion">
        SELECT examQuestion.*
        , examCourse.course_name AS courseName
        FROM exam_question examQuestion
        LEFT JOIN exam_course examCourse ON examQuestion.course_id = examCourse.id
        <include refid="whereCondition"/>
        ORDER BY examQuestion.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM exam_question examQuestion
        LEFT JOIN exam_course examCourse ON examQuestion.course_id = examCourse.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.law.train.module.exam_question.entity.ExamQuestion">
        SELECT examQuestion.*
        , examCourse.course_name AS courseName
        FROM exam_question examQuestion
        LEFT JOIN exam_course examCourse ON examQuestion.course_id = examCourse.id
        <include refid="whereCondition"/>
        ORDER BY examQuestion.create_time DESC
    </select>

    <!-- 随机取一道题 -->
    <select id="getRandomOne" resultType="com.law.train.module.exam_question.entity.ExamQuestion">
        SELECT examQuestion.*
        , examCourse.course_name AS courseName
        FROM exam_question examQuestion
        LEFT JOIN exam_course examCourse ON examQuestion.course_id = examCourse.id
        <include refid="whereCondition"/>
        ORDER BY RAND() LIMIT 1
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.law.train.module.exam_question.entity.ExamQuestion">
        SELECT examQuestion.*
        , examCourse.course_name AS courseName
        FROM exam_question examQuestion
        LEFT JOIN exam_course examCourse ON examQuestion.course_id = examCourse.id
        WHERE examQuestion.id = #{id}
    </select>

</mapper>
