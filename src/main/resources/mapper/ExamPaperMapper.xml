<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.law.train.module.exam_paper.mapper.ExamPaperMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND examPaper.id = #{entity.id}
            </if>
            <if test="entity.paperName != null and entity.paperName != ''">
                AND examPaper.paper_name LIKE CONCAT('%', #{entity.paperName}, '%')
            </if>
            <if test="entity.paperType != null">
                AND examPaper.paper_type = #{entity.paperType}
            </if>
            <if test="entity.difficultyLevel != null">
                AND examPaper.difficulty_level = #{entity.difficultyLevel}
            </if>
            <if test="entity.status != null">
                AND examPaper.status = #{entity.status}
            </if>
            <if test="entity.courseId != null">
                AND examPaper.course_id = #{entity.courseId}
            </if>
            <if test="entity.courseName != null and entity.courseName != ''">
                AND examCourse.course_name LIKE CONCAT('%', #{entity.courseName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.law.train.module.exam_paper.entity.ExamPaper">
        SELECT examPaper.*
        , examCourse.course_name AS courseName
        FROM exam_paper examPaper
        LEFT JOIN exam_course examCourse ON examPaper.course_id = examCourse.id
        <include refid="whereCondition"/>
        ORDER BY examPaper.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM exam_paper examPaper
        LEFT JOIN exam_course examCourse ON examPaper.course_id = examCourse.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.law.train.module.exam_paper.entity.ExamPaper">
        SELECT examPaper.*
        , examCourse.course_name AS courseName
        FROM exam_paper examPaper
        LEFT JOIN exam_course examCourse ON examPaper.course_id = examCourse.id
        <include refid="whereCondition"/>
        ORDER BY examPaper.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.law.train.module.exam_paper.entity.ExamPaper">
        SELECT examPaper.*
        , examCourse.course_name AS courseName
        FROM exam_paper examPaper
        LEFT JOIN exam_course examCourse ON examPaper.course_id = examCourse.id
        WHERE examPaper.id = #{id}
    </select>

</mapper>
