<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.law.train.module.exam_review_plan.mapper.ExamReviewPlanMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND examReviewPlan.id = #{entity.id}
            </if>
            <if test="entity.studentId != null">
                AND examReviewPlan.student_id = #{entity.studentId}
            </if>
            <if test="entity.planName != null and entity.planName != ''">
                AND examReviewPlan.plan_name LIKE CONCAT('%', #{entity.planName}, '%')
            </if>
            <if test="entity.startDateStart != null and entity.startDateEnd != null">
                AND examReviewPlan.start_date BETWEEN #{entity.startDateStart} AND #{entity.startDateEnd}
            </if>
            <if test="entity.endDateStart != null and entity.endDateEnd != null">
                AND examReviewPlan.end_date BETWEEN #{entity.endDateStart} AND #{entity.endDateEnd}
            </if>
            <if test="entity.status != null">
                AND examReviewPlan.status = #{entity.status}
            </if>
            <if test="entity.realName != null and entity.realName != ''">
                AND examStudent.real_name LIKE CONCAT('%', #{entity.realName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.law.train.module.exam_review_plan.entity.ExamReviewPlan">
        SELECT examReviewPlan.*
        , examStudent.real_name AS realName
        FROM exam_review_plan examReviewPlan
        LEFT JOIN exam_student examStudent ON examReviewPlan.student_id = examStudent.id
        <include refid="whereCondition"/>
        ORDER BY examReviewPlan.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM exam_review_plan examReviewPlan
        LEFT JOIN exam_student examStudent ON examReviewPlan.student_id = examStudent.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.law.train.module.exam_review_plan.entity.ExamReviewPlan">
        SELECT examReviewPlan.*
        , examStudent.real_name AS realName
        FROM exam_review_plan examReviewPlan
        LEFT JOIN exam_student examStudent ON examReviewPlan.student_id = examStudent.id
        <include refid="whereCondition"/>
        ORDER BY examReviewPlan.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.law.train.module.exam_review_plan.entity.ExamReviewPlan">
        SELECT examReviewPlan.*
        , examStudent.real_name AS realName
        FROM exam_review_plan examReviewPlan
        LEFT JOIN exam_student examStudent ON examReviewPlan.student_id = examStudent.id
        WHERE examReviewPlan.id = #{id}
    </select>

</mapper>
