<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.law.train.module.exam_admin_user.mapper.ExamAdminUserMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND examAdminUser.id = #{entity.id}
            </if>
            <if test="entity.username != null and entity.username != ''">
                AND examAdminUser.username LIKE CONCAT('%', #{entity.username}, '%')
            </if>
            <if test="entity.realName != null and entity.realName != ''">
                AND examAdminUser.real_name LIKE CONCAT('%', #{entity.realName}, '%')
            </if>
            <if test="entity.roleType != null and entity.roleType != ''">
                AND examAdminUser.role_type = #{entity.roleType}
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                AND examAdminUser.phone LIKE CONCAT('%', #{entity.phone}, '%')
            </if>
            <if test="entity.email != null and entity.email != ''">
                AND examAdminUser.email LIKE CONCAT('%', #{entity.email}, '%')
            </if>
            <if test="entity.status != null">
                AND examAdminUser.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.law.train.module.exam_admin_user.entity.ExamAdminUser">
        SELECT examAdminUser.*
        FROM exam_admin_user examAdminUser
        <include refid="whereCondition"/>
        ORDER BY examAdminUser.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM exam_admin_user examAdminUser
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.law.train.module.exam_admin_user.entity.ExamAdminUser">
        SELECT examAdminUser.*
        FROM exam_admin_user examAdminUser
        <include refid="whereCondition"/>
        ORDER BY examAdminUser.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.law.train.module.exam_admin_user.entity.ExamAdminUser">
        SELECT examAdminUser.*
        FROM exam_admin_user examAdminUser
        WHERE examAdminUser.id = #{id}
    </select>

</mapper>
