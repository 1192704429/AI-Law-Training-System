<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.law.train.module.exam_student.mapper.ExamStudentMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND examStudent.id = #{entity.id}
            </if>
            <if test="entity.username != null and entity.username != ''">
                AND examStudent.username LIKE CONCAT('%', #{entity.username}, '%')
            </if>
            <if test="entity.realName != null and entity.realName != ''">
                AND examStudent.real_name LIKE CONCAT('%', #{entity.realName}, '%')
            </if>
            <if test="entity.gender != null">
                AND examStudent.gender = #{entity.gender}
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                AND examStudent.phone LIKE CONCAT('%', #{entity.phone}, '%')
            </if>
            <if test="entity.email != null and entity.email != ''">
                AND examStudent.email LIKE CONCAT('%', #{entity.email}, '%')
            </if>
            <if test="entity.gradeName != null and entity.gradeName != ''">
                AND examStudent.grade_name LIKE CONCAT('%', #{entity.gradeName}, '%')
            </if>
            <if test="entity.schoolName != null and entity.schoolName != ''">
                AND examStudent.school_name LIKE CONCAT('%', #{entity.schoolName}, '%')
            </if>
            <if test="entity.status != null">
                AND examStudent.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.law.train.module.exam_student.entity.ExamStudent">
        SELECT examStudent.*
        FROM exam_student examStudent
        <include refid="whereCondition"/>
        ORDER BY examStudent.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM exam_student examStudent
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.law.train.module.exam_student.entity.ExamStudent">
        SELECT examStudent.*
        FROM exam_student examStudent
        <include refid="whereCondition"/>
        ORDER BY examStudent.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.law.train.module.exam_student.entity.ExamStudent">
        SELECT examStudent.*
        FROM exam_student examStudent
        WHERE examStudent.id = #{id}
    </select>

</mapper>
